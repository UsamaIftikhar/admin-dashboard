{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/1njamaicamusic build",
  "outputDirectory": "artifacts/1njamaicamusic/dist/public",
  "rewrites": [
    {
      "source": "^/(?!api(?:/|$)).*$",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 30
    }
  }
}
